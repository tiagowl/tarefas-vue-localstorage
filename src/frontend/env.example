# Configuração de ambiente da aplicação (Vite).
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# Todas as variáveis precisam do prefixo VITE_ para serem expostas ao cliente.

# Título exibido no cabeçalho da aplicação.
VITE_APP_TITLE=Minhas Tarefas

# Chave do localStorage que guarda o envelope versionado de dados (ADR-006).
VITE_STORAGE_KEY=tarefas:data:v1

# Versão do schema de dados persistido (usada para migrações).
VITE_STORAGE_SCHEMA_VERSION=1

# Chave do localStorage que guarda preferências de UI (visão ativa).
VITE_PREFERENCES_KEY=tarefas:prefs:v1

# Quantidade de tarefas por página na visão Lista (RES-6).
VITE_PAGE_SIZE=8

# Tempo de debounce da busca por nome, em milissegundos (US-11).
VITE_SEARCH_DEBOUNCE_MS=200
